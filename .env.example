# Environment Configuration

# Server
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
CORS_ORIGIN=*

# GitHub API
GITHUB_TOKEN=your_github_token_here

# Clone Settings
CLONE_BASE_DIR=./projects
CLONE_TIMEOUT=60000

# Rate Limiting
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100

# Cache
CACHE_TTL=3600000
CACHE_MAX_SIZE=1000

# Puppeteer
PUPPETEER_HEADLESS=true
PUPPETEER_TIMEOUT=30000
