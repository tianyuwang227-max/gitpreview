{
  "version": 2,
  "builds": [
    {
      "src": "dist/**/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/dist/modules/web-server/index.js" },
    { "src": "/screenshots/(.*)", "dest": "/dist/modules/web-server/index.js" },
    { "src": "/discover", "dest": "/public/discover.html" },
    { "src": "/search", "dest": "/public/search.html" },
    { "src": "/favorites", "dest": "/public/discover.html" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}
