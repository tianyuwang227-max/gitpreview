{
  "name": "gitpreview",
  "version": "1.0.0",
  "description": "Preview GitHub repositories locally - personal use only",
  "main": "dist/modules/web-server/index.js",
  "scripts": {
    "dev": "ts-node src/modules/web-server/index.ts",
    "build": "tsc",
    "start": "node dist/modules/web-server/index.js",
    "test": "jest --forceExit",
